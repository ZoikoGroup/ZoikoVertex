PORT=5000
CLIENT_URL=http://localhost:5173

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=

# Security
# Comma-separated emails allowed to use admin endpoints (unanswered prompts, escalations)
ADMIN_EMAILS=
# Extra comma-separated CORS origins (zoikovertex.com and app.getzoikovertex.com are built in)
CORS_ORIGINS=
# Reverse-proxy hops in front of the app (Render / VM nginx = 1), used for per-IP rate limits
TRUST_PROXY_HOPS=1

# Public website chat (PUBLIC_WEB mode)
PUBLIC_SITE_URL=https://zoikovertex.com
PLATFORM_LOGIN_URL=https://getzoikovertex.com/login

# Mail — transcripts and handoffs are only ever sent to SUPPORT_EMAIL, from FROM_EMAIL
SUPPORT_EMAIL=info@zoikovertex.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Mail — Resend (https://resend.com)
RESEND_API_KEY=
FROM_EMAIL=info@zoikovertex.com

# AI Provider (Groq active; Gemini available as alt)
AI_PROVIDER=groq
AI_API_KEY=
AI_MODEL=llama-3.3-70b-versatile

# For Gemini, swap the block above with:
# AI_PROVIDER=gemini
# AI_API_KEY=your-gemini-api-key
# AI_MODEL=gemini-2.0-flash
